---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import { site, projects, typologies, url } from '../../config';
---
<Base title={`Proyectos — ${site.name}`} description="Listado de proyectos de Grupo LA.">
  <Header />

  <main>
    <section class="page-hero glow">
      <div class="grid-lines" aria-hidden="true"></div>
      <div class="container">
        <p class="eyebrow">Proyectos</p>
        <h1 class="h1" style="margin-top:18px">Obra construida</h1>
        <p class="lead" style="margin-top:20px">
          Remodelaciones, interiores y locales comerciales ejecutados en Caracas.
          Cada ficha reúne el alcance, los materiales y el antes / después.
        </p>
        <div class="filters" role="tablist" aria-label="Filtrar por tipología">
          {typologies.map((t, i) => (
            <button class={`filter ${i === 0 ? 'is-active' : ''}`} data-filter={t} type="button">
              {t}
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="border-top:0;padding-top:0">
      <div class="container">
        <div class="projects" id="projects-grid">
          {projects.map((p) => (
            <a class="project-card" href={url(`/proyectos/${p.slug}`)} data-typology={p.typology}>
              <div class="project-card__media">
                <MediaPlaceholder label={p.title} sublabel="Foto del proyecto · pendiente" variant="dark" />
              </div>
              <div class="project-card__body">
                <span class="project-card__type">{p.typology}</span>
                <h3 class="project-card__title">{p.title}</h3>
                <p class="project-card__meta">{p.meta}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta">
          <div class="cta__inner">
            <p class="eyebrow">Siguiente paso</p>
            <h2 class="h2" style="margin-top:18px">¿Tienes un espacio parecido en mente?</h2>
            <p class="lead" style="margin-top:18px">
              Cuéntanos qué quieres lograr y te decimos por dónde empezar.
            </p>
            <div class="row" style="margin-top:26px">
              <a class="btn btn--primary btn--lg" href={url('/contacto')}>Solicitar cotización</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    (function () {
      const btns = document.querySelectorAll('.filter');
      const cards = document.querySelectorAll('.project-card');
      btns.forEach((b) => {
        b.addEventListener('click', () => {
          btns.forEach((x) => x.classList.remove('is-active'));
          b.classList.add('is-active');
          const f = b.getAttribute('data-filter');
          cards.forEach((c) => {
            const t = c.getAttribute('data-typology');
            c.style.display = f === 'Todos' || f === t ? '' : 'none';
          });
        });
      });
    })();
  </script>
</Base>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 7vw, 88px) 0 clamp(32px, 4vw, 48px);
  }

  .filters { margin-top: 32px; }

  .projects { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

  .cta {
    background:
      radial-gradient(90% 120% at 15% 0%, rgba(255, 255, 255, 0.1), transparent 55%),
      var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
  }

  .cta__inner { padding: clamp(28px, 5vw, 56px); max-width: 700px; }

  @media (max-width: 760px) {
    .projects { grid-template-columns: 1fr; }
  }
</style>
