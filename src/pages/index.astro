---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import { site, projects, about, url } from '../config';

const featured = projects.filter((p) => p.featured).slice(0, 3);
---
<Base title={`${site.name} — ${site.tagline}`} description={site.description}>
  <Header />

  <main>
    <!-- HOME: una sola imagen potente + nombre del estudio -->
    <section class="hero hero--image" data-reveal>
      <MediaPlaceholder label="Imagen de obra" sublabel="Fotografía a pantalla completa (pendiente)" variant="dark" class="hero-media" />
      <div class="container hero-overlay">
        <p class="eyebrow">{site.tagline}</p>
        <h1 class="display">{site.name}</h1>
        <p class="hero-lede">
          Arquitectura, ingeniería y diseño interior. Proyectos y obras en Caracas.
        </p>
      </div>
    </section>

    <!-- WORK: listado limpio de proyectos estrella -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Work</p>
          <h2 class="h2">Proyectos seleccionados</h2>
          <p class="lead">
            Una muestra del trabajo reciente. Cada proyecto abre su ficha con foto, planos y memoria.
          </p>
        </div>
        <div class="project-list">
          {featured.map((p, i) => (
            <a class="project-row" href={url(`/proyectos/${p.slug}`)} data-reveal>
              <div class="project-row__media">
                <MediaPlaceholder label={p.title} sublabel="Foto del proyecto (pendiente)" variant="dark" />
              </div>
              <div class="project-row__body">
                <span class="project-row__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="project-row__title">{p.title}</h3>
                <p class="project-row__meta">{p.meta}</p>
              </div>
            </a>
          ))}
        </div>
        <p class="more-link">
          <a href={url('/proyectos')}>Ver todos los proyectos →</a>
        </p>
      </div>
    </section>

    <!-- PROFILE teaser -->
    <section class="section section--paper2">
      <div class="container profile-teaser">
        <p class="eyebrow">Profile</p>
        <h2 class="h2">Detrás de Grupo LA está la Arq. Luz Aché</h2>
        <p class="lead">{about.paragraphs[0]}</p>
        <a href={url('/perfil')} class="text-link">Leer perfil completo →</a>
      </div>
    </section>

    <!-- CONTACT teaser -->
    <section class="section">
      <div class="container contact-teaser">
        <p class="eyebrow">Contact</p>
        <h2 class="h2">Hablemos de tu obra</h2>
        <p class="lead">
          {site.contact.email} · {site.contact.whatsappNumber}
        </p>
        <a href={url('/contacto')} class="btn btn--primary">Contactar</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .hero--image {
    position: relative;
    min-height: 100vh;
    display: grid;
    align-items: end;
    padding: 0 0 clamp(48px, 6vw, 80px);
    overflow: hidden;
    background: var(--ink);
    color: #fff;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-media .media-ph { height: 100%; border: 0; }
  .hero-overlay {
    position: relative;
    z-index: 2;
  }
  .hero--image .eyebrow { color: rgba(255,255,255,0.7); }
  .hero--image .hero-lede { color: rgba(255,255,255,0.7); max-width: 46ch; }
  .hero--image h1 { color: #fff; }
  .hero-lede { margin-top: var(--s-4); font-size: 1.05rem; }

  .project-list { display: grid; gap: clamp(48px, 6vw, 80px); margin-top: var(--s-7); }
  .project-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .project-row__media .media-ph { aspect-ratio: 4 / 3; }
  .project-row__num {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: var(--s-3);
  }
  .project-row__title { font-size: clamp(1.5rem, 2.6vw, 2.2rem); margin: 0 0 var(--s-2); }
  .project-row__meta { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .project-row:hover .project-row__title { text-decoration: underline; text-underline-offset: 4px; }

  .profile-teaser, .contact-teaser { max-width: 62ch; }
  .text-link { display: inline-block; margin-top: var(--s-5); color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .more-link { margin-top: var(--s-6); }
  .more-link a { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 760px) {
    .project-row { grid-template-columns: 1fr; gap: var(--s-4); }
    .hero--image { min-height: 80vh; }
  }
</style>