---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site, services, process, projects, about, allies, social, faqs, quoteForm, url } from '../config';

const igUrl = (handle: string) => `https://www.instagram.com/${handle.replace('@', '')}/`;
---

<Base>
  {site.demo && (
    <div class="demo-bar">
      <div class="container">
        <strong>Demo</strong>
        <span>{site.demoNotice}</span>
      </div>
    </div>
  )}

  <Header />

  <main>
    <!-- HERO (estilo Norm Architects: foto grande + texto superpuesto) -->
    <section class="hero hero--photo">
      <div class="hero-media">
        <div class="media-ph media-ph--dark hero-media-ph" aria-hidden="true"></div>
        <div class="hero-overlay">
          <div class="container">
            <p class="eyebrow">Grupo LA — Caracas, Venezuela</p>
            <h1>Proyectos que se piensan<br />y obras que <em>se entregan</em>.</h1>
            <p class="lead">
              Diseñamos, calculamos, inspeccionamos y ejecutamos obras en casas, apartamentos,
              oficinas y locales. Un mismo responsable del primer plano a la entrega.
            </p>
            <div class="hero-actions">
              <a class="btn btn--primary" href={url('#cotizar')}>
                Pedir cotización
                <Icon name="arrow" size={18} />
              </a>
              <a class="btn btn--ghost" href={url('#proyectos')}>Ver proyectos</a>
            </div>
          </div>
        </div>
        <span class="hero-arrow" aria-hidden="true">‹</span>
      </div>

      <div class="container">
        <div class="hero-foot">
          <span>Visita de levantamiento sin costo en {site.contact.serviceArea}</span>
          <span>
            Obra en proceso en{' '}
            <a href={social.instagramHref} target="_blank" rel="noopener">{social.instagramHandle}</a>
          </span>
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section class="section" id="servicios" data-reveal>
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <h2>Todo lo que una obra necesita,<br />en un solo equipo</h2>
          </div>
          <p class="lead">
            Del proyecto a la entrega: diseño, cálculo, inspección y ejecución coordinados por el
            mismo equipo, para que no tengas que conseguir cinco profesionales distintos.
          </p>
        </div>

        <ul class="service-list">
          {services.map((service, i) => (
            <li class="service">
              <span class="service-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{service.title}</h3>
              <p>{service.desc}</p>
              <span class="service-icon"><Icon name="arrow" size={18} /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PROYECTOS -->
    <section class="section section--paper2" id="proyectos" data-reveal>
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <h2>Nuestros proyectos</h2>
          </div>
          <p class="lead">
            Cada obra se documenta con fotos de antes y después. Los proyectos son reales;
            las fotos están pendientes de entrega por el cliente.
          </p>
        </div>

        <div class="projects">
          {projects.map((project) => (
            <ProjectCard
              title={project.title}
              meta={project.meta}
              summary={project.summary}
              tags={project.tags}
              wide={Boolean(project.featured)}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESO -->
    <section class="section" id="proceso" data-reveal>
      <div class="container">
        <div class="section-head section-head--split">
          <div><h2>Cuatro pasos, cero sorpresas</h2></div>
          <p class="lead">
            El proceso es el mismo para un baño o para una obra completa: medir, presupuestar por
            partidas, ejecutar con reportes y entregar con checklist.
          </p>
        </div>

        <div class="steps">
          {process.map((item) => (
            <div class="step">
              <span class="step-num">{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- NOSOTROS -->
    <section class="section section--paper2" id="nosotros" data-reveal>
      <div class="container">
        <div class="about-grid">
          <div>
            <h2>{about.title}</h2>
            {about.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
            <ul class="about-list">
              {about.bullets.map((bullet) => (
                <li>
                  <Icon name="check" size={17} />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
          <figure class="pull">
            <p>«Un solo árbol no hace montaña.»</p>
            <footer>Arq. Luz Aché · Fundadora de Grupo LA</footer>
          </figure>
        </div>
      </div>
    </section>

    <!-- ALIADOS -->
    <section class="section section--dark" data-reveal>
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <span class="eyebrow">Aliados</span>
            <h2>La obra se hace en equipo</h2>
          </div>
          <p class="lead">
            Para mobiliario, mármol, iluminación y climatización trabajamos con talleres de
            confianza que ya conocen nuestra forma de ejecutar.
          </p>
        </div>

        <ul class="allies">
          {allies.map((ally) => (
            <li>
              <a href={igUrl(ally.handle)} target="_blank" rel="noopener">
                <strong>{ally.handle}</strong>
                <span>{ally.role}</span>
                <Icon name="arrow" size={16} />
              </a>
            </li>
          ))}
        </ul>

        <div class="ally-cta">
          <a class="btn btn--primary" href={social.instagramHref} target="_blank" rel="noopener">
            <Icon name="instagram" size={18} />
            {social.label}
          </a>
          <p class="lead">{social.instagramHandle} — {social.note}</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq" data-reveal>
      <div class="container">
        <div class="section-head section-head--split">
          <div><h2>Lo que más preguntan<br />antes de firmar</h2></div>
          <p class="lead">
            Si tu duda no está aquí, escríbenos por Instagram o deja el formulario: respondemos
            igual, sin compromiso.
          </p>
        </div>

        <div class="faq">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- COTIZAR -->
    <section class="section section--dark" id="cotizar" data-reveal>
      <div class="container">
        <div class="quote-wrap">
          <div class="quote-side">
            <span class="eyebrow">Cotización</span>
            <h2>{quoteForm.title}</h2>
            <p class="lead">{quoteForm.subtitle}</p>
            <ul class="contact-list">
              <li>
                <span>Teléfono</span>
                {site.contact.phoneHref
                  ? <a href={site.contact.phoneHref}>{site.contact.phone}</a>
                  : <span class="placeholder">{site.contact.phone}</span>}
              </li>
              <li>
                <span>WhatsApp</span>
                {site.contact.whatsappHref
                  ? <a href={site.contact.whatsappHref}>{site.contact.whatsappNumber}</a>
                  : <span class="placeholder">{site.contact.whatsappNumber}</span>}
              </li>
              <li>
                <span>Correo</span>
                {site.contact.emailHref
                  ? <a href={site.contact.emailHref}>{site.contact.email}</a>
                  : <span class="placeholder">{site.contact.email}</span>}
              </li>
              <li>
                <span>Instagram</span>
                <a href={social.instagramHref} target="_blank" rel="noopener">
                  {social.instagramHandle}
                </a>
              </li>
              <li>
                <span>Oficina</span>
                <span class="placeholder">{site.contact.address}</span>
              </li>
            </ul>
          </div>
          <QuoteForm />
        </div>
      </div>
    </section>
  </main>

  <Footer />

  {site.contact.whatsappHref && (
    <a class="wa-float" href={site.contact.whatsappHref} aria-label="Escribir por WhatsApp">
      <Icon name="whatsapp" size={20} />
      <span>WhatsApp</span>
    </a>
  )}
</Base>
