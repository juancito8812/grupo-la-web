---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import { site, about, allies, social, url } from '../config';
---
<Base title={`Perfil — ${site.name}`} description={about.title}>
  <Header />

  <main class="section">
    <div class="container">
      <p class="eyebrow">Profile</p>
      <h1 class="h1">{about.title}</h1>

      <div class="profile-grid">
        <div>
          {about.paragraphs.map((p) => <p class="lead">{p}</p>)}
          <ul class="about-list" style="margin-top:var(--s-5)">
            {about.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <div>
          <MediaPlaceholder label="Arq. Luz Aché" sublabel="Foto del equipo (pendiente)" variant="light" />
        </div>
      </div>

      <section style="margin-top:var(--s-8)">
        <p class="eyebrow">Aliados</p>
        <h2 class="h2">La obra se hace en equipo</h2>
        <ul class="allies" style="margin-top:var(--s-5)">
          {allies.map((a) => (
            <li>
              <a href={`https://www.instagram.com/${a.handle.replace('@','')}/`} target="_blank" rel="noopener">
                <strong>{a.handle}</strong>
                <span>{a.role}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .h1 { font-size: clamp(2rem, 4vw, 3.2rem); margin: var(--s-2) 0 var(--s-4); }
  .h2 { font-size: clamp(1.5rem, 2.6vw, 2.2rem); margin: var(--s-2) 0 var(--s-4); }
  .profile-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: start; margin-top: var(--s-5); }
  .about-list { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .about-list li { padding-left: 20px; position: relative; color: var(--muted); font-size: 0.95rem; }
  .about-list li::before { content: '—'; position: absolute; left: 0; color: var(--ink); }
  .allies { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .allies a { display: flex; justify-content: space-between; align-items: center; padding: var(--s-3) 0; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; }
  .allies strong { font-weight: 500; }
  .allies span { color: var(--muted); font-size: 0.85rem; }
  @media (max-width: 760px) { .profile-grid { grid-template-columns: 1fr; } }
</style>