---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, nav, social, url } from '../config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={url('')} style="color:#fff">
          <Logo size={38} />
          <span>
            {site.name}
            <small>{site.tagline}</small>
          </span>
        </a>
        <p style="margin-top:16px;font-size:.9rem;max-width:36ch">{site.description}</p>
      </div>
      <div>
        <h4>Secciones</h4>
        <ul>
          {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
          <li><a href={url('#cotizar')}>Cotizar</a></li>
        </ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul>
          <li>
            {site.contact.phoneHref
              ? <a href={site.contact.phoneHref}>{site.contact.phone}</a>
              : site.contact.phone}
          </li>
          {site.contact.whatsappHref && (
            <li><a href={site.contact.whatsappHref}>WhatsApp</a></li>
          )}
          <li>
            {site.contact.emailHref
              ? <a href={site.contact.emailHref}>{site.contact.email}</a>
              : site.contact.email}
          </li>
          <li>{site.contact.address}</li>
          <li>{site.contact.hours}</li>
          <li>
            <a href={social.instagramHref} target="_blank" rel="noopener">
              <Icon name="instagram" size={16} /> {social.instagramHandle}
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.name}. Todos los derechos reservados.</span>
      <span>{site.demo ? 'Sitio en construcción · contenido de demostración' : ''}</span>
    </div>
  </div>
</footer>
