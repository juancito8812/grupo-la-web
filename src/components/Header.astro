---
import Logo from './Logo.astro';
import { site, nav, url, social } from '../config';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('')} aria-label={`${site.name} — inicio`}>
      <Logo size={26} />
      <span>{site.name}</span>
      <span class="brand__slash">/</span>
      <span class="brand__tag">Estudio</span>
    </a>

    <nav class="nav nav--desktop" aria-label="Navegación principal">
      {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="btn btn--ghost header-actions__ig" href={social.instagramHref} target="_blank" rel="noopener">
        Instagram ↗
      </a>
      <a class="btn btn--primary" href={url('/contacto')}>Cotizar</a>
    </div>

    <details class="mnav">
      <summary aria-label="Abrir menú">
        <span class="mnav__bars" aria-hidden="true"><i></i><i></i></span>
        <span class="mnav__label">Menú</span>
      </summary>
      <div class="mnav__panel">
        <nav aria-label="Navegación móvil">
          {nav.map((item, i) => (
            <a href={url(item.href)}>
              <span class="mnav__num">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          ))}
        </nav>
        <a class="mnav__extra" href={social.instagramHref} target="_blank" rel="noopener">
          Instagram {social.instagramHandle} ↗
        </a>
      </div>
    </details>
  </div>
</header>

<style>
  .brand__tag {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-4);
  }

  /* Menú móvil */
  .mnav { display: none; position: relative; }

  .mnav summary {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    cursor: pointer;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-2);
    user-select: none;
  }
  .mnav summary::-webkit-details-marker { display: none; }

  .mnav__bars { display: grid; gap: 3px; }
  .mnav__bars i {
    display: block;
    width: 13px;
    height: 1px;
    background: currentColor;
    transition: transform 0.2s var(--ease);
  }
  .mnav[open] .mnav__bars i:first-child { transform: translateY(2px) rotate(45deg); }
  .mnav[open] .mnav__bars i:last-child { transform: translateY(-2px) rotate(-45deg); }

  .mnav__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    z-index: 60;
    width: min(74vw, 258px);
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface-2);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.55);
  }

  .mnav__panel nav { display: grid; }

  .mnav__panel nav a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 11px 8px;
    font-size: 15px;
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid var(--line-soft);
  }
  .mnav__panel nav a:last-child { border-bottom: 0; }

  .mnav__num {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--fg-4);
  }

  .mnav__extra {
    display: block;
    margin-top: 8px;
    padding: 10px 8px 4px;
    border-top: 1px solid var(--line-soft);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--fg-3);
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .nav--desktop, .header-actions__ig { display: none; }
    .mnav { display: block; }
  }

  @media (max-width: 520px) {
    .brand__slash, .brand__tag { display: none; }
  }
</style>
