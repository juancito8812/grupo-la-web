---
import { url } from '../config';

interface Props {
  size?: number;
  class?: string;
}
const { size = 38, class: klass = '' } = Astro.props;
---
<img
  src={url('logo.png')}
  alt="Grupo LA"
  width={size}
  height={size}
  class={klass}
  style="border-radius:50%;object-fit:cover;display:block;"
  loading="eager"
  decoding="async"
/>
